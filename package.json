    "date-fns": "^4.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "next-auth": "^4.24.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/json2csv": "^5.0.7",
