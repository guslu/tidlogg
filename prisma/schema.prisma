generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

model User {
  id              String              @id @default(cuid())
  name            String?
  email           String              @unique
  passwordHash    String
  emailVerified   DateTime?
  image           String?
  memberships     WorkspaceMember[]
  timeEntries     TimeEntry[]
  activeWorkspace UserActiveWorkspace?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Workspace {
  id               String                 @id @default(cuid())
  name             String
  members          WorkspaceMember[]
  clients          Client[]
  projects         Project[]
  tags             Tag[]
  timeEntries      TimeEntry[]
  invites          WorkspaceInvite[]
  activeWorkspaces UserActiveWorkspace[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model UserActiveWorkspace {
  userId      String    @id
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  archivedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, archivedAt])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String?
  name        String
  billableRate Decimal?
  budgetMinutes Int?
  archivedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, archivedAt])
  @@index([clientId])
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entryTags   TimeEntryTag[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
}

model TimeEntry {
  id          String      @id @default(cuid())
  workspaceId String
  userId      String
  projectId   String
  description String      @default("")
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?
  isBillable  Boolean     @default(true)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tags        TimeEntryTag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId, userId, startedAt])
  @@index([workspaceId, userId, endedAt, startedAt])
  @@index([workspaceId, projectId, startedAt])
  @@index([projectId, endedAt])
  @@index([workspaceId, endedAt])
}

model TimeEntryTag {
  timeEntryId String
  tagId       String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([timeEntryId, tagId])
  @@index([tagId])
}
